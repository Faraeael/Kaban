<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <!-- Header bar: App / Wallet Name + Switcher buttons -->
    <LinearLayout
        android:id="@+id/qr_header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/qr_wallet_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Receive QR"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/qr_btn_prev"
            android:layout_width="34dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_chip_bg"
            android:text="◀"
            android:textSize="12sp"
            android:textColor="#FFFFFFFF"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/qr_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="1/1"
            android:textSize="11sp"
            android:textColor="#AAFFFFFF" />

        <TextView
            android:id="@+id/qr_btn_next"
            android:layout_width="34dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_chip_bg"
            android:text="▶"
            android:textSize="12sp"
            android:textColor="#FFFFFFFF"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <TextView
        android:id="@+id/qr_account_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tap to configure in Kaban"
        android:textSize="11sp"
        android:textColor="#CCFFFFFF"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingBottom="6dp" />

    <!-- QR Image Card -->
    <LinearLayout
        android:id="@+id/qr_card_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFFFF"
        android:gravity="center"
        android:padding="8dp">

        <ImageView
            android:id="@+id/qr_image_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:contentDescription="Wallet Receive QR Code" />
    </LinearLayout>
</LinearLayout>
