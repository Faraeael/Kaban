<?xml version="1.0" encoding="utf-8"?>
<!--
    Home Screen widget layout for Kaban Quick Log.
    Complies strictly with Android RemoteViews requirements:
    - Uses only supported views (LinearLayout, TextView)
    - Zero <View> spacer elements (unsupported in RemoteViews)
    - Zero AppCompat styles (Launcher process lacks Theme.AppCompat)
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="10dp">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚡ Quick Log"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kaban"
            android:textSize="11sp"
            android:textColor="#AAFFFFFF" />
    </LinearLayout>

    <!-- Row 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_preset_0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_chip_bg"
            android:text="—"
            android:textSize="11sp"
            android:textColor="#FFFFFFFF"
            android:gravity="center"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/btn_preset_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_chip_bg"
            android:text="—"
            android:textSize="11sp"
            android:textColor="#FFFFFFFF"
            android:gravity="center"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true"
            android:maxLines="2"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Row 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_preset_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_chip_bg"
            android:text="—"
            android:textSize="11sp"
            android:textColor="#FFFFFFFF"
            android:gravity="center"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/btn_preset_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_chip_bg"
            android:text="—"
            android:textSize="11sp"
            android:textColor="#FFFFFFFF"
            android:gravity="center"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true"
            android:maxLines="2"
            android:ellipsize="end" />

    </LinearLayout>

</LinearLayout>
